      "title": "RuleStageNameV3",
      "type": "string"
    },
    "TimeBoundaryV3": {
      "additionalProperties": false,
      "properties": {
        "inclusive": {
          "title": "Inclusive",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ValueSourceKindV3"
        },
        "parameterName": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parametername"
        },
        "value": {
