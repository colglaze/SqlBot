    "RuleOperator": {
      "enum": [
        "eq",
        "ne",
        "gt",
        "gte",
        "lt",
        "lte",
        "in",
        "not_in",
        "is_null",
        "is_not_null",
        "is_blank",
        "is_not_blank",
        "contains",
        "not_contains"
