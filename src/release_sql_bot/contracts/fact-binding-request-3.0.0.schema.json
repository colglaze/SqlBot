{
  "$defs": {
    "AggregationFunctionV3": {
      "enum": [
        "sum",
        "count",
        "countDistinct",
        "avg",
        "min",
        "max"
      ],
      "title": "AggregationFunctionV3",
      "type": "string"
    },
    "AggregationModeV3": {
      "enum": [
        "none",
        "precomputed",
        "compute",
        "exists"
      ],
      "title": "AggregationModeV3",
      "type": "string"
    },
    "AggregationRequirementV3": {
      "additionalProperties": false,
      "properties": {
        "distinct": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distinct"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "function": {
          "anyOf": [
            {
              "$ref": "#/$defs/AggregationFunctionV3"
            },
            {
              "type": "null"
            }
          ]
        },
        "groupByFieldIds": {
          "items": {
            "type": "string"
          },
          "title": "Groupbyfieldids",
          "type": "array"
        },
        "inputFieldIds": {
          "items": {
            "type": "string"
          },
          "title": "Inputfieldids",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/AggregationModeV3"
        }
      },
      "required": [
        "mode",
        "function",
        "inputFieldIds",
        "groupByFieldIds",
        "distinct",
        "evidenceIds"
      ],
      "title": "AggregationRequirementV3",
      "type": "object"
    },
    "BindableFactV3": {
      "additionalProperties": false,
      "properties": {
        "allowedValues": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Allowedvalues",
          "type": "array"
        },
        "dataType": {
          "$ref": "#/$defs/FactDataType"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "factCode": {
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Factcode",
          "type": "string"
        },
        "factKind": {
          "enum": [
            "source",
            "aggregate",
            "exists"
          ],
          "title": "Factkind",
          "type": "string"
        },
        "grain": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Grain",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nullPolicy": {
          "$ref": "#/$defs/NullPolicy"
        },
        "nullable": {
          "title": "Nullable",
          "type": "boolean"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/FactParameterV3"
          },
          "minItems": 1,
          "title": "Parameters",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "factCode",
        "name",
        "factKind",
        "dataType",
        "description",
        "nullable",
        "nullPolicy",
        "grain",
        "parameters"
      ],
      "title": "BindableFactV3",
      "type": "object"
    },
    "BindingMappingCandidateV2": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "viewActive": {
                "type": "null"
              },
              "viewField": {
                "type": "null"
              },
              "viewName": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "mappingStatus": {
                "const": "mapped"
              }
            }
          },
          "then": {
            "properties": {
              "viewField": {
                "type": "string"
              },
              "viewName": {
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "factCode": {
          "description": "Fact code to which this mapping hint belongs.",
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Factcode",
          "type": "string"
        },
        "mappingStatus": {
          "$ref": "#/$defs/MappingStatus",
          "description": "Whether a catalog field was matched."
        },
        "note": {
          "description": "Human-review note without executable SQL.",
          "maxLength": 1000,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "reviewStatus": {
          "const": "candidate",
          "description": "Mapping is never promoted to approved by RuleReader.",
          "title": "Reviewstatus",
          "type": "string"
        },
        "viewActive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Catalog activity hint, or null.",
          "title": "Viewactive"
        },
        "viewField": {
          "anyOf": [
            {
              "maxLength": 150,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Candidate output field, or null when unresolved.",
          "title": "Viewfield"
        },
        "viewName": {
          "anyOf": [
            {
              "maxLength": 150,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Candidate view/relation name, or null when unresolved.",
          "title": "Viewname"
        }
      },
      "required": [
        "factCode",
        "mappingStatus",
        "viewName",
        "viewField",
        "viewActive",
        "reviewStatus",
        "note"
      ],
      "title": "BindingMappingCandidateV2",
      "type": "object"
    },
    "EntityRequirementV3": {
      "additionalProperties": false,
      "properties": {
        "entityType": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Entitytype",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "grain": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Grain",
          "type": "string"
        },
        "keyParameters": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Keyparameters",
          "type": "array"
        }
      },
      "required": [
        "entityType",
        "grain",
        "keyParameters",
        "evidenceIds"
      ],
      "title": "EntityRequirementV3",
      "type": "object"
    },
    "EvidenceKindV3": {
      "enum": [
        "factDeclaration",
        "conditionUsage",
        "queryRequirement",
        "sourceProvenance",
        "example"
      ],
      "title": "EvidenceKindV3",
      "type": "string"
    },
    "EvidenceV3": {
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "maxLength": 200,
          "pattern": "^[a-z][A-Za-z0-9_.:-]*$",
          "title": "Evidenceid",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKindV3"
        },
        "sourceDocument": {
          "enum": [
            "ruleResult",
            "candidate",
            "catalog"
          ],
          "title": "Sourcedocument",
          "type": "string"
        },
        "sourcePath": {
          "maxLength": 1000,
          "pattern": "^/",
          "title": "Sourcepath",
          "type": "string"
        }
      },
      "required": [
        "evidenceId",
        "kind",
        "sourceDocument",
        "sourcePath"
      ],
      "title": "EvidenceV3",
      "type": "object"
    },
    "FactDataType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "date",
        "datetime",
        "enum",
        "money",
        "list",
        "unknown"
      ],
      "title": "FactDataType",
      "type": "string"
    },
    "FactExampleV3": {
      "additionalProperties": false,
      "properties": {
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "exampleId": {
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Exampleid",
          "type": "string"
        },
        "expectedOutcome": {
          "$ref": "#/$defs/RuleOutcomeV3"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "exampleId",
        "value",
        "expectedOutcome",
        "evidenceIds"
      ],
      "title": "FactExampleV3",
      "type": "object"
    },
    "FactParameterV3": {
      "additionalProperties": false,
      "properties": {
        "dataType": {
          "$ref": "#/$defs/FactDataType"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "enum": [
            "entityKey",
            "filter",
            "timeAnchor"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role",
        "dataType",
        "required",
        "description"
      ],
      "title": "FactParameterV3",
      "type": "object"
    },
    "FactUsageV3": {
      "additionalProperties": false,
      "properties": {
        "conditionId": {
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Conditionid",
          "type": "string"
        },
        "conditionPath": {
          "maxLength": 1000,
          "pattern": "^/",
          "title": "Conditionpath",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/RuleOutcomeV3"
        },
        "priority": {
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "ruleCode": {
          "maxLength": 120,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Rulecode",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/RuleStageNameV3"
        }
      },
      "required": [
        "stage",
        "ruleCode",
        "priority",
        "conditionId",
        "conditionPath",
        "outcome",
        "evidenceIds"
      ],
      "title": "FactUsageV3",
      "type": "object"
    },
    "FieldRequirementV3": {
      "additionalProperties": false,
      "properties": {
        "dataType": {
          "$ref": "#/$defs/FactDataType"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "fieldId": {
          "maxLength": 160,
          "pattern": "^[a-z][A-Za-z0-9_.-]*$",
          "title": "Fieldid",
          "type": "string"
        },
        "logicalName": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Logicalname",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/FieldRoleV3"
        }
      },
      "required": [
        "fieldId",
        "role",
        "logicalName",
        "dataType",
        "required",
        "evidenceIds"
      ],
      "title": "FieldRequirementV3",
      "type": "object"
    },
    "FieldRoleV3": {
      "enum": [
        "value",
        "entityKey",
        "filter",
        "groupBy",
        "time"
      ],
      "title": "FieldRoleV3",
      "type": "string"
    },
    "FilterRequirementV3": {
      "additionalProperties": false,
      "properties": {
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "fieldId": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Fieldid",
          "type": "string"
        },
        "filterId": {
          "maxLength": 160,
          "pattern": "^[a-z][A-Za-z0-9_.-]*$",
          "title": "Filterid",
          "type": "string"
        },
        "nullPolicy": {
          "$ref": "#/$defs/NullPolicy"
        },
        "operator": {
          "$ref": "#/$defs/RuleOperator"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilterValueV3"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "filterId",
        "fieldId",
        "operator",
        "value",
        "nullPolicy",
        "required",
        "evidenceIds"
      ],
      "title": "FilterRequirementV3",
      "type": "object"
    },
    "FilterSetV3": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "const": "complete",
          "title": "Completeness",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/FilterRequirementV3"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items",
        "completeness",
        "evidenceIds"
      ],
      "title": "FilterSetV3",
      "type": "object"
    },
    "FilterValueV3": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ValueSourceKindV3"
        },
        "literal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal"
        },
        "parameterName": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parametername"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FilterValueV3",
      "type": "object"
    },
    "MappingStatus": {
      "enum": [
        "mapped",
        "unresolved"
      ],
      "title": "MappingStatus",
      "type": "string"
    },
    "NullPolicy": {
      "enum": [
        "fail",
        "pass",
        "indeterminate",
        "error"
      ],
      "title": "NullPolicy",
      "type": "string"
    },
    "ProvenanceV3": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "parserVersion": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Parserversion",
          "type": "string"
        },
        "promptVersion": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Promptversion",
          "type": "string"
        },
        "provider": {
          "enum": [
            "deepseek",
            "reviewed_import"
          ],
          "title": "Provider",
          "type": "string"
        },
        "relativePath": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relativepath"
        },
        "sourceCharacterCount": {
          "minimum": 1,
          "title": "Sourcecharactercount",
          "type": "integer"
        },
        "sourceName": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Sourcename",
          "type": "string"
        },
        "sourceSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sourcesha256",
          "type": "string"
        }
      },
      "required": [
        "sourceName",
        "sourceSha256",
        "sourceCharacterCount",
        "parserVersion",
        "promptVersion",
        "provider",
        "model"
      ],
      "title": "ProvenanceV3",
      "type": "object"
    },
    "QueryRequirementsV3": {
