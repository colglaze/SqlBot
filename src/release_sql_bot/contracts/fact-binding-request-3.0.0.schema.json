          "title": "Columnname",
          "type": "string"
        },
        "dataType": {
          "$ref": "#/$defs/FactDataType"
        },
        "nullPolicy": {
          "$ref": "#/$defs/NullPolicy"
        },
        "nullable": {
          "title": "Nullable",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
