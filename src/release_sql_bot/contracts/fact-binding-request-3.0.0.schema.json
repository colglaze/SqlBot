        "READY",
        "WAITING_COMPLETION",
        "WAITING_CONDITIONS",
        "NO_RELEASE_REQUIRED",
        "ALREADY_RELEASED",
        "SKIPPED",
        "INDETERMINATE"
      ],
      "title": "RuleOutcomeV3",
      "type": "string"
    },
    "RuleRefV3": {
      "additionalProperties": false,
      "properties": {
        "candidatePayloadSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidatepayloadsha256",
          "type": "string"
        },
        "catalogDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Catalogdigest",
          "type": "string"
        },
        "ruleSetId": {
          "maxLength": 120,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Rulesetid",
          "type": "string"
        },
        "ruleVersion": {
          "maxLength": 260,
          "minLength": 1,
          "title": "Ruleversion",
          "type": "string"
        },
        "schemaVersion": {
          "const": "3.0.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "sourceSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sourcesha256",
          "type": "string"
        }
