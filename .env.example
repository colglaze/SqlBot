# ReleaseSQLBot 本地配置模板。
# 复制为 .env 后填写；.env 不会被 Git 提交。进程环境变量会覆盖本文件。
# 不要把真实 URI、用户名、密码或 API Key 写入 .env.example。

# 服务
RSB_SERVICE_NAME=ReleaseSQLBot
RSB_ENVIRONMENT=local
RSB_LOG_LEVEL=INFO
RSB_API_HOST=127.0.0.1
RSB_API_PORT=8010

# 数据库总开关：默认关闭；仅在 MongoDB 只读配置完整后才可设为 true。
RSB_DATABASE_ENABLED=false

# RuleReader MongoDB（只读账号）
# URI 示例仅供格式参考：mongodb://username:password@host:27017/?authSource=admin
RSB_MONGODB_URI=
RSB_MONGODB_DATABASE=rule_reader
RSB_MONGODB_FACT_BINDING_COLLECTION=fact_binding_handoffs
# 上游 Schema v5 的 V3 单文档批次集合（每个精确 ruleVersion 一个 batch）。
RSB_MONGODB_FACT_BINDING_BATCH_COLLECTION=fact_binding_handoff_batches_v3
RSB_MONGODB_RULE_COLLECTION=rule_versions
RSB_MONGODB_READ_ONLY=true
RSB_MONGODB_TLS=false
RSB_MONGODB_TLS_CA_FILE=
RSB_MONGODB_SERVER_SELECTION_TIMEOUT_SECONDS=5
RSB_MONGODB_CONNECT_TIMEOUT_SECONDS=5
RSB_MONGODB_OPERATION_TIMEOUT_SECONDS=5

# 目标 SQL Server（最小权限只读账号）
RSB_SQLSERVER_HOST=
RSB_SQLSERVER_PORT=1433
RSB_SQLSERVER_DATABASE=
# 可选：sql_login / windows_integrated
RSB_SQLSERVER_AUTH_MODE=sql_login
RSB_SQLSERVER_USERNAME=
RSB_SQLSERVER_PASSWORD=
RSB_SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
RSB_SQLSERVER_ENCRYPT=true
# 仅本地自签名证书排障时才考虑 true；生产环境应保持 false。
RSB_SQLSERVER_TRUST_SERVER_CERTIFICATE=false
RSB_SQLSERVER_READ_ONLY=true
RSB_SQLSERVER_APPLICATION_INTENT=ReadOnly
RSB_SQLSERVER_LOGIN_TIMEOUT_SECONDS=10
RSB_SQLSERVER_QUERY_TIMEOUT_SECONDS=30
RSB_SQLSERVER_MAX_ROWS=1000
RSB_SQLSERVER_MAX_RESULT_BYTES=5000000
# JSON 数组；需要数据库确认 schema 后填写，例如 ["dbo"]。
RSB_SQLSERVER_SCHEMA_ALLOWLIST=[]
# 当前字段清单工作簿的本机绝对路径；该文件只作为候选对象范围输入。
RSB_SQLSERVER_METADATA_WORKBOOK_PATH=

# Phase 5A 受限 SQL Server 描述验证（独立开关，默认关闭；不复用 RSB_DATABASE_ENABLED）。
# 启用要求：非生产 environment 与 environmentClass、目标/凭据/profile 完整、
# 加密且不信任服务器证书、参数 HMAC key 至少 16 字符。
RSB_SQLSERVER_VALIDATION_ENABLED=false
RSB_SQLSERVER_VALIDATION_PROFILE_ID=
# 可选：development / staging；production 会在配置阶段被拒绝。
RSB_SQLSERVER_VALIDATION_ENVIRONMENT_CLASS=development
# Phase 5A 只允许 ["describeOnly"]。
RSB_SQLSERVER_VALIDATION_ALLOWED_MODES=["describeOnly"]
RSB_SQLSERVER_VALIDATION_MAX_CONCURRENT_RUNS=1
RSB_SQLSERVER_LOCK_TIMEOUT_MILLISECONDS=2000
RSB_SQLSERVER_VALIDATION_MAX_DESCRIBE_ROWS=1000
RSB_SQLSERVER_VALIDATION_MAX_DESCRIBE_BYTES=1000000
# 服务端参数值指纹 HMAC key；不要写入真实密钥。
RSB_SQLSERVER_VALIDATION_PARAMETER_HMAC_KEY=
# 允许的 SQL Server 主版本（JSON 数组）。
RSB_SQLSERVER_SUPPORTED_MAJOR_VERSIONS=[13,14,15,16,17]

# DeepSeek（API Key、base URL 和模型全部配置后启用候选生成）
RSB_DEEPSEEK_API_KEY=
RSB_DEEPSEEK_BASE_URL=
RSB_DEEPSEEK_MODEL=deepseek-v4-flash
RSB_DEEPSEEK_TIMEOUT_SECONDS=90
RSB_DEEPSEEK_MAX_RETRIES=2

# SQL 安全边界
RSB_SQL_DIALECT=sqlserver
RSB_TEMP_TABLE_ALLOWED=false

# V2 候选模板持久化（SqlBot 自有库/集合；insert-only，按 contentSha256 幂等）。
# 开启需已配置 RSB_MONGODB_URI，且该账号对目标库有建集合/写权限；
# RuleReader 库不受影响，intake 保持只读。
RSB_CANDIDATE_STORE_ENABLED=false
RSB_CANDIDATE_STORE_DATABASE=release_sql_bot
RSB_CANDIDATE_STORE_COLLECTION=sql_template_candidates

# V3 准备入口只读取批准记录和有效指针，不创建记录或索引。
RSB_APPROVAL_STORE_V3_ENABLED=false
RSB_APPROVAL_STORE_V3_DATABASE=release_sql_bot
RSB_APPROVAL_STORE_V3_COLLECTION=approval_records_v3
RSB_APPROVAL_STORE_V3_ACTIVE_POINTER_COLLECTION=approval_record_active_pointers_v3

# V3 生成持久化：独立于 V2，仅在 SqlBot 自有集合插入并创建唯一哈希索引。
RSB_CANDIDATE_STORE_V3_ENABLED=false
RSB_CANDIDATE_STORE_V3_DATABASE=release_sql_bot
RSB_CANDIDATE_STORE_V3_COLLECTION=sql_template_candidates_v3

# 证据中模型身份的精确允许列表。以下为离线默认值；在线运行按已批准配置登记。
RSB_EVIDENCE_TRUSTED_PROVIDERS=["fixed-offline-v3"]
RSB_EVIDENCE_TRUSTED_MODELS=["fixed-model-v3"]
RSB_EVIDENCE_TRUSTED_PROMPT_VERSIONS=["sqlserver-fact-candidate-v3.0","sqlserver-fact-candidate-v3.1"]
