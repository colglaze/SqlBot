# ReleaseSQLBot 本地配置模板。
# 复制为 .env 后填写；.env 不会被 Git 提交。进程环境变量会覆盖本文件。
# 不要把真实 URI、用户名、密码或 API Key 写入 .env.example。

# 服务
RSB_SERVICE_NAME=ReleaseSQLBot
RSB_ENVIRONMENT=local
RSB_LOG_LEVEL=INFO
RSB_API_HOST=127.0.0.1
RSB_API_PORT=8010

# 数据库总开关：默认关闭；仅在 MongoDB 只读配置完整后才可设为 true。
RSB_DATABASE_ENABLED=false

# RuleReader MongoDB（只读账号）
# URI 示例仅供格式参考：mongodb://username:password@host:27017/?authSource=admin
RSB_MONGODB_URI=
RSB_MONGODB_DATABASE=rule_reader
RSB_MONGODB_FACT_BINDING_COLLECTION=fact_binding_handoffs
RSB_MONGODB_RULE_COLLECTION=rule_versions
RSB_MONGODB_READ_ONLY=true
RSB_MONGODB_TLS=false
RSB_MONGODB_TLS_CA_FILE=
RSB_MONGODB_SERVER_SELECTION_TIMEOUT_SECONDS=5
RSB_MONGODB_CONNECT_TIMEOUT_SECONDS=5
RSB_MONGODB_OPERATION_TIMEOUT_SECONDS=5

# 目标 SQL Server（最小权限只读账号）
RSB_SQLSERVER_HOST=
RSB_SQLSERVER_PORT=1433
RSB_SQLSERVER_DATABASE=
# 可选：sql_login / windows_integrated
RSB_SQLSERVER_AUTH_MODE=sql_login
RSB_SQLSERVER_USERNAME=
RSB_SQLSERVER_PASSWORD=
RSB_SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
RSB_SQLSERVER_ENCRYPT=true
# 仅本地自签名证书排障时才考虑 true；生产环境应保持 false。
RSB_SQLSERVER_TRUST_SERVER_CERTIFICATE=false
RSB_SQLSERVER_READ_ONLY=true
RSB_SQLSERVER_APPLICATION_INTENT=ReadOnly
RSB_SQLSERVER_LOGIN_TIMEOUT_SECONDS=10
RSB_SQLSERVER_QUERY_TIMEOUT_SECONDS=30
RSB_SQLSERVER_MAX_ROWS=1000
RSB_SQLSERVER_MAX_RESULT_BYTES=5000000
# JSON 数组；需要数据库确认 schema 后填写，例如 ["dbo"]。
RSB_SQLSERVER_SCHEMA_ALLOWLIST=[]
# 当前字段清单工作簿的本机绝对路径；该文件只作为候选对象范围输入。
RSB_SQLSERVER_METADATA_WORKBOOK_PATH=

# DeepSeek（API Key、base URL 和模型全部配置后启用候选生成）
RSB_DEEPSEEK_API_KEY=
RSB_DEEPSEEK_BASE_URL=
RSB_DEEPSEEK_MODEL=deepseek-v4-flash
RSB_DEEPSEEK_TIMEOUT_SECONDS=90
RSB_DEEPSEEK_MAX_RETRIES=2

# SQL 安全边界
RSB_SQL_DIALECT=sqlserver
RSB_TEMP_TABLE_ALLOWED=false
